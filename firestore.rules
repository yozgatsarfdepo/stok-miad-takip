rules_version = '2';

// DİKKAT: Bu kural, siteyi bilen herkesin stok verisini okuyup yazabilmesine izin verir.
// Kurum içi/kapalı kullanım için uygundur. Siteyi herkese açık yayınlıyorsanız
// Firebase Authentication ekleyip kuralı kullanıcı doğrulamasına bağlayın.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stok/{malzemeId} {
      allow read, write: if true;
    }
    // Degisiklik gecmisi (aciklama ve alan degisiklik kayitlari)
    match /stok_gecmis/{kayitId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
